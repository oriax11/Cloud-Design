{
  "containerDefinitions": [
    {
      "name": "api-gateway",
      "image": "docker.io/1ee5lim/api-gateway-app:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp",
          "name": "api-gateway"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "PYTHONUNBUFFERED",
          "value": "1"
        },
        {
          "name": "RABBITMQ_PORT",
          "value": "5672"
        },
        {
          "name": "INVENTORY_APP_PORT",
          "value": "8080"
        },
        {
          "name": "APIGATEWAY_PORT",
          "value": "3000"
        },
        {
          "name": "INVENTORY_APP_HOST",
          "value": "inventory-app"
        },
        {
          "name": "COGNITO_REGION",
          "value": "us-east-1"
        },
        {
          "name": "RABBITMQ_HOST",
          "value": "rabbit-queue"
        },
        {
          "name": "COGNITO_APP_CLIENT_ID",
          "value": "1v7flqle34h92226afobf7dgl9"
        },
        {
          "name": "COGNITO_USER_POOL_ID",
          "value": "us-east-1_GcVf3Cz38"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "RABBITMQ_USER",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:006631837921:secret:cloud-design/app-secrets-xNELH7:RABBITMQ_USER::"
        },
        {
          "name": "RABBITMQ_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:006631837921:secret:cloud-design/app-secrets-xNELH7:RABBITMQ_PASSWORD::"
        },
        {
          "name": "RABBITMQ_QUEUE",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:006631837921:secret:cloud-design/app-secrets-xNELH7:RABBITMQ_QUEUE::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/cloud-design-api-gateway",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api-gateway"
        }
      },
      "systemControls": []
    }
  ],
  "family": "cloud-design-api-gateway",
  "taskRoleArn": "arn:aws:iam::006631837921:role/cloud-design-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::006631837921:role/cloud-design-ecs-execution-role",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
