{
  "containerDefinitions": [
    {
      "name": "inventory-db",
      "image": "docker.io/oriax11/inventory-db:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 5432,
          "hostPort": 5432,
          "protocol": "tcp",
          "name": "postgres"
        }
      ],
      "essential": true,
      "environment": [],
      "mountPoints": [
        {
          "sourceVolume": "inventory-db-data",
          "containerPath": "/var/lib/postgresql/",
          "readOnly": false
        }
      ],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:006631837921:secret:cloud-design/app-secrets-xNELH7:INVENTORY_DB_USER::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:006631837921:secret:cloud-design/app-secrets-xNELH7:INVENTORY_DB_PASSWORD::"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:006631837921:secret:cloud-design/app-secrets-xNELH7:INVENTORY_DB_NAME::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/cloud-design-inventory-db",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "inventory-db"
        }
      },
      "systemControls": []
    }
  ],
  "family": "cloud-design-inventory-db",
  "taskRoleArn": "arn:aws:iam::006631837921:role/cloud-design-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::006631837921:role/cloud-design-ecs-execution-role",
  "networkMode": "awsvpc",
  "volumes": [
    {
      "name": "inventory-db-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-01846b030633edcac",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-081211c5dc4aa508b",
          "iam": "ENABLED"
        }
      }
    }
  ],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
